// POPSLoader: ps2sdk iop/dev9/atad/src/imports.lst with the #ifdef branches
// resolved for THIS module's fixed config (ATA_USE_DEV9=1, ATA_ENABLE_BDM=1,
// ATA_USE_AIFDEV9=0). The upstream list relies on the SDK's own preprocessing
// pass; modules/Rules.bin.make does not run one, so the branches are settled
// here instead of at build time.

loadcore_IMPORTS_start
I_RegisterLibraryEntries
loadcore_IMPORTS_end

thbase_IMPORTS_start
I_DelayThread
I_SetAlarm
I_CancelAlarm
I_USec2SysClock
thbase_IMPORTS_end

thevent_IMPORTS_start
I_CreateEventFlag
I_iSetEventFlag
I_ClearEventFlag
I_WaitEventFlag
thevent_IMPORTS_end

stdio_IMPORTS_start
I_printf
stdio_IMPORTS_end

sysclib_IMPORTS_start
I_memcpy
I_memset
sysclib_IMPORTS_end

dev9_IMPORTS_start
I_SpdRegisterIntrHandler
I_SpdDmaTransfer
I_SpdIntrEnable
I_SpdIntrDisable
I_SpdSetLED
I_Dev9RegisterPowerOffHandler
I_dev9RegisterPreDmaCb
I_dev9RegisterPostDmaCb
dev9_IMPORTS_end

bdm_IMPORTS_start
I_bdm_connect_bd
I_bdm_disconnect_bd
bdm_IMPORTS_end
